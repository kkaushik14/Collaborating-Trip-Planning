# Import into Vercel Project > Settings > Environment Variables.
# Run npm run env:vercel to generate a private copy with distinct JWT secrets.
NODE_ENV=production
MONGO_URI=mongodb+srv://REPLACE_ME:REPLACE_ME@REPLACE_ME.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=collaborating_trip_planning
JWT_ACCESS_SECRET=GENERATE_WITH_npm_run_env_vercel
JWT_REFRESH_SECRET=GENERATE_WITH_npm_run_env_vercel
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Absolute site origin, no trailing /api/v1. Blank uses Vercel's deployment URL.
# Set these to your stable production domain before sending invitations.
FRONTEND_BASE_URL=
CORS_ORIGIN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME@gmail.com
SMTP_PASS=REPLACE_ME_WITH_GOOGLE_APP_PASSWORD
SMTP_FROM=REPLACE_ME@gmail.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AUDIT_LOG_ENABLED=true
DOCS_ENABLED=true
# Public build-time configuration; never put secrets in VITE_* variables.
VITE_API_BASE_URL=/api/v1
VITE_API_HEALTH_PATH=/health
VITE_API_TIMEOUT_MS=30000
VITE_USE_API_MOCKS=false
VITE_ALLOW_PROD_MOCKS=false
